{
  "name": "@oncehub/ui-react",
  "private": false,
  "version": "3.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scheduleonce/once-ui-react.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/ui-react.umd.js",
  "module": "./dist/ui-react.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "styles": "./dist/index.css",
      "import": "./dist/ui-react.es.js",
      "require": "./dist/ui-react.umd.js"
    },
    "./components/select": "./dist/components/select/*",
    "./components/multi-select": {
      "types": "./dist/components/multi-select/multi-select.type.d.ts"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "build:lib": "tsc && vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "fix:lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test:prettier": "prettier --check --ignore-unknown \"src/**/*.{ts,tsx,js,mdx}\"",
    "fix:prettier": "prettier --write --ignore-unknown \"src/**/*.{ts,tsx,js,mdx}\"",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "prepack": "json -f package.json -I -e \"delete this.devDependencies; delete this.dependencies; delete this.packageManager; delete this.scripts.preinstall\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@oncehub/relative-luminance": "^2.1.4",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "9.1.7",
    "jsdom": "^29.0.0",
    "json": "11.0.0",
    "libphonenumber-js": "^1.13.15",
    "lint-staged": "^15.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.0.3",
    "react": "^19.0.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.0.0",
    "react-phone-number-input": "^3.4.17",
    "sass": "^1.69.5",
    "storybook": "10.6.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.2",
    "vite": "^8.3.5",
    "vite-plugin-css-injected-by-js": "^3.5.0",
    "vite-plugin-dts": "4.3.0",
    "vitest": "4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier -w"
    ]
  },
  "peerDependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.0.18",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.0.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.0.0",
    "react-phone-number-input": "^3.4.11"
  }
}
